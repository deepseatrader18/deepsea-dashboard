# Optional: powers "Jarvis, smart karo: <instruction>" — an EXPERIMENTAL
# mode where it looks at a screenshot and decides what to click/type on its
# own, step by step (see README's "Smart karo" section). Get a free key at
# https://aistudio.google.com/apikey. Leave blank to skip this one feature
# only — every other command above still works without it.
GEMINI_API_KEY=

# Optional: which Edge TTS voice speaks the welcome/confirm lines. Default
# is a natural Indian-English voice. Run `edge-tts --list-voices` (after
# `pip install -r requirements.txt`) to see all options, e.g. hi-IN-MadhurNeural.
# Used as the fallback voice whenever ELEVENLABS_API_KEY below isn't set,
# or an ElevenLabs call fails.
EDGE_TTS_VOICE=en-IN-NeerjaNeural

# Optional: a much more natural voice than Edge TTS, but requires a PAID
# ElevenLabs plan (Starter or above) — the free tier blocks API access to
# voices entirely. Leave blank to keep using free Edge TTS with no other
# changes needed. Get the key from https://elevenlabs.io/app/settings/api-keys
# after subscribing.
ELEVENLABS_API_KEY=
# Pick a voice from https://elevenlabs.io/app/voice-library and paste its
# ID here. Default below is ElevenLabs' premade "Rachel" voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_multilingual_v2 handles Hindi text; eleven_turbo_v2_5 is
# faster/cheaper if you only ever need English.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional overrides (defaults shown)
CLAP_ENABLED=true
CLAP_SONG_URI=
CLAP_DASHBOARD_URL=https://deepsea-dashboard.onrender.com
CLAP_WELCOME_PHRASE=Wake up. Welcome home, sir. DeepSea dashboard is ready.
CLAP_SPIKE_RATIO=6.0

# If the terminal shows "Heard: <something>" that's clearly you saying
# "DeepSea" but it's not being recognized, add what it heard here
# (comma-separated, lowercase) and restart — no code change needed.
WAKE_WORDS_EXTRA=

# --- WhatsApp bridge (whatsapp-bridge.js) ---
# Same secret as WHATSAPP_BRIDGE_TOKEN set on the deepsea-dashboard Render
# service — pick any random string, it just has to match on both sides.
# Setting this also turns on laptop-command control from WhatsApp (see
# README): assistant.py starts a localhost-only server that only accepts
# requests carrying this same token.
WHATSAPP_BRIDGE_TOKEN=set_this_same_value_on_render_too
# Dashboard URL the bridge calls for DeepSea's replies.
DASHBOARD_CHAT_URL=https://deepsea-dashboard.onrender.com
# Optional: force a specific chat instead of auto-detecting your
# "Message Yourself" chat, e.g. 91XXXXXXXXXX@c.us
ALLOWED_WHATSAPP_CHAT_ID=
# Optional: change if port 8765 is already used by something else on your
# laptop. Must match between assistant.py (ASSISTANT_LOCAL_PORT) and the
# bridge (LOCAL_ASSISTANT_URL) — easiest to just leave both at default.
ASSISTANT_LOCAL_PORT=8765
LOCAL_ASSISTANT_URL=http://127.0.0.1:8765

# --- Discord bridge (discord-bridge.js), optional backup for WhatsApp ---
# From https://discord.com/developers/applications: New Application -> Bot
# tab -> Reset Token (copy it) -> under "Privileged Gateway Intents" turn on
# "Message Content Intent". Leave blank to skip the Discord bridge entirely.
DISCORD_BOT_TOKEN=
# Your own Discord user ID (enable Developer Mode in Discord settings, then
# right-click your name -> Copy User ID). Without this, anyone who can
# message the bot could command it.
ALLOWED_DISCORD_USER_ID=
