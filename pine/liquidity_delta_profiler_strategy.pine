// Backtest version of "Liquidity Delta Profiler" by LuxAlgo
// Original work licensed under CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/
// © LuxAlgo — adapted for strategy testing (non-commercial use only)
//@version=6
strategy("Liquidity Delta Profiler Strategy [Backtest]", "LDP Strategy", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.percent, commission_value = 0.0, slippage = 2,
     pyramiding = 0, max_boxes_count = 500, max_labels_count = 500)

//---------------------------------------------------------------------------------------------------------------------}
// Settings
//---------------------------------------------------------------------------------------------------------------------{
length         = input.int(15, "Pivot Length", minval = 2, group = "Zones")
maxZones       = input.int(10, "Max Zones per Type", minval = 1, maxval = 40, group = "Zones")
filterOverlaps = input.bool(true, "Filter Overlapping Zones", group = "Zones")
showZones      = input.bool(true, "Show Zones", group = "Zones")

useABS   = input.bool(true, "ABS", group = "Signals to Trade", inline = "sig")
useEXH   = input.bool(true, "EXH", group = "Signals to Trade", inline = "sig")
useDIV   = input.bool(true, "DIV", group = "Signals to Trade", inline = "sig")
useREJ   = input.bool(true, "REJ", group = "Signals to Trade", inline = "sig")
tradeDir = input.string("Both", "Direction", options = ["Both", "Long Only", "Short Only"], group = "Signals to Trade")

slBuffer   = input.float(0.5, "SL Buffer beyond Zone/Wick (x ATR)", minval = 0, step = 0.1, group = "Risk", tooltip = "Stop loss goes beyond the zone extreme or the signal bar's wick, whichever is further, plus this ATR buffer.")
minRiskAtr = input.float(0.3, "Min SL Distance (x ATR)", minval = 0.05, step = 0.05, group = "Risk", tooltip = "Prevents unrealistically tight stops.")
rr         = input.float(2.0, "Take Profit (R:R)", minval = 0.1, step = 0.1, group = "Risk")
maxBars    = input.int(0, "Max Bars in Trade (0 = off)", minval = 0, group = "Risk", tooltip = "Closes the trade at market after this many bars if neither SL nor TP was hit.")

useDate   = input.bool(false, "Limit Date Range", group = "Backtest")
startDate = input.time(timestamp("2024-01-01"), "Start", group = "Backtest")
endDate   = input.time(timestamp("2099-12-31"), "End", group = "Backtest")
showStats = input.bool(true, "Show Per-Signal Stats Table", group = "Backtest")

bslColor = input.color(#f23645, "BSL Color", group = "Style")
sslColor = input.color(#089981, "SSL Color", group = "Style")

//---------------------------------------------------------------------------------------------------------------------}
// Types / Variables
//---------------------------------------------------------------------------------------------------------------------{
type Zone
    float top
    float bottom
    bool swept
    bool signaled
    float[] deltas
    box outline

var Zone[] bslZones = array.new<Zone>()
var Zone[] sslZones = array.new<Zone>()

//---------------------------------------------------------------------------------------------------------------------}
// Functions
//---------------------------------------------------------------------------------------------------------------------{
barOverlap(float barH, float barL, float qTop, float qBot) =>
    float overlapTop = math.min(barH, qTop)
    float overlapBot = math.max(barL, qBot)
    overlapTop > overlapBot ? overlapTop - overlapBot : 0.0

isEnabled(string s) =>
    s == "ABS" ? useABS : s == "EXH" ? useEXH : s == "DIV" ? useDIV : s == "REJ" ? useREJ : false

// Same signal rules as the original indicator (ABS -> EXH -> DIV -> REJ, first match wins)
detectSignal(Zone z, bool isBsl, float barDelta, float barVol) =>
    string signalType = ""
    float absTotalD = 0.0
    for d in z.deltas
        absTotalD += math.abs(d)
    if absTotalD > 0
        float outerD = z.deltas.get(isBsl ? 3 : 0)
        float ratio = math.abs(outerD) / (absTotalD + 0.0001)
        bool isSweeping = isBsl ? high > z.top : low < z.bottom
        bool closesInside = close <= z.top and close >= z.bottom
        float midPoint = (z.top + z.bottom) / 2
        bool closesRejecting = isBsl ? close < midPoint : close > midPoint
        float barRatio = math.abs(barDelta) / (barVol + 0.0001)
        if isSweeping and ((isBsl and outerD < 0) or (not isBsl and outerD > 0)) and ratio > 0.2
            signalType := "ABS"
        else if isSweeping and ratio < 0.1
            signalType := "EXH"
        else if closesInside and ratio > 0.6 and ((isBsl and outerD > 0) or (not isBsl and outerD < 0))
            signalType := "DIV"
        else if isSweeping and closesRejecting and ((isBsl and barDelta < 0) or (not isBsl and barDelta > 0)) and barRatio > 0.2
            signalType := "REJ"
    signalType

newZone(float top, float bottom, int leftIdx, color c) =>
    box ob = box.new(leftIdx, top, bar_index, bottom, border_color = color.new(c, showZones ? 40 : 100), bgcolor = color.new(c, showZones ? 85 : 100))
    Zone.new(top, bottom, false, false, array.new<float>(4, 0.0), ob)

//---------------------------------------------------------------------------------------------------------------------}
// Zone Detection
//---------------------------------------------------------------------------------------------------------------------{
float atr = ta.atr(14)
float ph = ta.pivothigh(high, length, length)
float pl = ta.pivotlow(low, length, length)

if not na(ph)
    int pivotIdx = bar_index - length
    float pHigh = high[length]
    float pBot = math.max(close[length], open[length])
    if pHigh - pBot < atr[length] * 0.1
        pBot := pHigh - atr[length] * 0.1

    bool skip = false
    if filterOverlaps and bslZones.size() > 0
        for i = bslZones.size() - 1 to 0
            if i < bslZones.size()
                Zone ex = bslZones.get(i)
                if not ex.swept and math.max(pBot, ex.bottom) <= math.min(pHigh, ex.top)
                    if pHigh > ex.top
                        ex.outline.delete()
                        bslZones.remove(i)
                    else
                        skip := true
                        break

    if not skip
        bslZones.unshift(newZone(pHigh, pBot, pivotIdx, bslColor))
        if bslZones.size() > maxZones
            Zone removed = bslZones.pop()
            removed.outline.delete()

if not na(pl)
    int pivotIdx = bar_index - length
    float pLow = low[length]
    float pTop = math.min(close[length], open[length])
    if pTop - pLow < atr[length] * 0.1
        pTop := pLow + atr[length] * 0.1

    bool skip = false
    if filterOverlaps and sslZones.size() > 0
        for i = sslZones.size() - 1 to 0
            if i < sslZones.size()
                Zone ex = sslZones.get(i)
                if not ex.swept and math.max(pLow, ex.bottom) <= math.min(pTop, ex.top)
                    if pLow < ex.bottom
                        ex.outline.delete()
                        sslZones.remove(i)
                    else
                        skip := true
                        break

    if not skip
        sslZones.unshift(newZone(pTop, pLow, pivotIdx, sslColor))
        if sslZones.size() > maxZones
            Zone removed = sslZones.pop()
            removed.outline.delete()

//---------------------------------------------------------------------------------------------------------------------}
// Zone Update + Signals
//---------------------------------------------------------------------------------------------------------------------{
float vol = nz(volume)
float totalRange = high - low
float barDelta = totalRange == 0 ? 0 : vol * (close - open) / totalRange

string sigType = ""
int sigDir = 0
float sigTop = na
float sigBot = na

for side = 0 to 1
    bool isBsl = side == 0
    Zone[] zones = isBsl ? bslZones : sslZones
    if zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            if not z.swept
                z.outline.set_right(bar_index)
                bool hit = false
                float step = (z.top - z.bottom) / 4
                for j = 0 to 3
                    float qBot = z.bottom + j * step
                    float overlap = barOverlap(high, low, qBot + step, qBot)
                    if overlap > 0
                        hit := true
                        z.deltas.set(j, z.deltas.get(j) + barDelta * overlap / totalRange)

                if isBsl ? high > z.top : low < z.bottom
                    z.swept := true
                    z.outline.set_border_style(line.style_dashed)
                    z.outline.set_bgcolor(color.new(isBsl ? bslColor : sslColor, showZones ? 95 : 100))

                if (hit or z.swept) and not z.signaled
                    string s = detectSignal(z, isBsl, barDelta, vol)
                    if s != ""
                        z.signaled := true
                        bool tradable = isEnabled(s)
                        color lc = color.new(isBsl ? color.red : color.green, tradable ? 10 : 70)
                        label.new(bar_index, isBsl ? high : low, s, color = lc, textcolor = color.white, size = size.small,
                             style = isBsl ? label.style_label_down : label.style_label_up)
                        if sigType == "" and tradable
                            sigType := s
                            sigDir := isBsl ? -1 : 1
                            sigTop := z.top
                            sigBot := z.bottom

//---------------------------------------------------------------------------------------------------------------------}
// Orders
//---------------------------------------------------------------------------------------------------------------------{
bool inRange = not useDate or (time >= startDate and time <= endDate)
bool dirOk = sigDir == 1 ? tradeDir != "Short Only" : tradeDir != "Long Only"

if sigType != "" and inRange and dirOk and strategy.position_size == 0 and not na(atr)
    float entry = close
    float stop = sigDir == 1 ? math.min(low, sigBot) - atr * slBuffer : math.max(high, sigTop) + atr * slBuffer
    float risk = math.max(math.abs(entry - stop), atr * minRiskAtr)
    stop := entry - sigDir * risk
    float target = entry + sigDir * risk * rr
    string id = sigType + (sigDir == 1 ? " Long" : " Short")
    strategy.entry(id, sigDir == 1 ? strategy.long : strategy.short)
    strategy.exit(id + " Exit", id, stop = stop, limit = target, comment_loss = "SL", comment_profit = "TP")

if strategy.position_size != 0 and maxBars > 0
    int entryBar = strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    if bar_index - entryBar >= maxBars
        strategy.close_all(comment = "Time Exit")

//---------------------------------------------------------------------------------------------------------------------}
// Per-Signal Stats
//---------------------------------------------------------------------------------------------------------------------{
var int[]   statTrades = array.new<int>(4, 0)
var int[]   statWins   = array.new<int>(4, 0)
var float[] statGross  = array.new<float>(4, 0.0)
var float[] statLoss   = array.new<float>(4, 0.0)
var int processed = 0

while processed < strategy.closedtrades
    string eid = strategy.closedtrades.entry_id(processed)
    int k = str.startswith(eid, "ABS") ? 0 : str.startswith(eid, "EXH") ? 1 : str.startswith(eid, "DIV") ? 2 : 3
    float p = strategy.closedtrades.profit(processed)
    statTrades.set(k, statTrades.get(k) + 1)
    if p > 0
        statWins.set(k, statWins.get(k) + 1)
        statGross.set(k, statGross.get(k) + p)
    else
        statLoss.set(k, statLoss.get(k) - p)
    processed += 1

var table stats = table.new(position.top_right, 5, 6, bgcolor = #161616, frame_color = #2E2E2E, frame_width = 1, border_width = 1, border_color = #2E2E2E)

if barstate.islast and showStats
    stats.cell(0, 0, "Signal",   text_color = #808080, text_size = size.small)
    stats.cell(1, 0, "Trades",   text_color = #808080, text_size = size.small)
    stats.cell(2, 0, "Win %",    text_color = #808080, text_size = size.small)
    stats.cell(3, 0, "Net P&L",  text_color = #808080, text_size = size.small)
    stats.cell(4, 0, "PF",       text_color = #808080, text_size = size.small)
    array<string> names = array.from("ABS", "EXH", "DIV", "REJ")
    for k = 0 to 3
        int n = statTrades.get(k)
        float winPct = n > 0 ? statWins.get(k) * 100.0 / n : 0.0
        float net = statGross.get(k) - statLoss.get(k)
        float pf = statLoss.get(k) > 0 ? statGross.get(k) / statLoss.get(k) : na
        color pc = n == 0 ? #DBDBDB : net > 0 ? color.green : color.red
        stats.cell(0, k + 1, names.get(k), text_color = #DBDBDB, text_size = size.small, text_halign = text.align_left)
        stats.cell(1, k + 1, str.tostring(n), text_color = #DBDBDB, text_size = size.small)
        stats.cell(2, k + 1, str.tostring(winPct, "#.#") + "%", text_color = #DBDBDB, text_size = size.small)
        stats.cell(3, k + 1, str.tostring(net, "#.##"), text_color = pc, text_size = size.small)
        stats.cell(4, k + 1, na(pf) ? (statGross.get(k) > 0 ? "∞" : "-") : str.tostring(pf, "#.##"), text_color = pc, text_size = size.small)
    float totNet = strategy.netprofit
    stats.cell(0, 5, "ALL", text_color = #DBDBDB, text_size = size.small, text_halign = text.align_left)
    stats.cell(1, 5, str.tostring(strategy.closedtrades), text_color = #DBDBDB, text_size = size.small)
    stats.cell(2, 5, str.tostring(strategy.closedtrades > 0 ? strategy.wintrades * 100.0 / strategy.closedtrades : 0.0, "#.#") + "%", text_color = #DBDBDB, text_size = size.small)
    stats.cell(3, 5, str.tostring(totNet, "#.##"), text_color = totNet > 0 ? color.green : color.red, text_size = size.small)
    stats.cell(4, 5, strategy.grossloss > 0 ? str.tostring(strategy.grossprofit / strategy.grossloss, "#.##") : "-", text_color = totNet > 0 ? color.green : color.red, text_size = size.small)

//---------------------------------------------------------------------------------------------------------------------}
