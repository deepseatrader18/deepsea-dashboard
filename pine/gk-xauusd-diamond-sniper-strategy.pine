//@version=6
strategy("GK XAUUSD Sniper — Backtest", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=100, commission_type=strategy.commission.cash_per_contract, commission_value=0.0, slippage=0, pyramiding=0, process_orders_on_close=false, calc_on_every_tick=false, margin_long=0.1, margin_short=0.1, max_labels_count=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// SIGNAL INPUTS (same as indicator)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
mainLen = input.int(34, "Main Trend Length", minval=2)
fastLen = input.int(13, "Fast Trigger Length", minval=2)
atrLen = input.int(14, "ATR Length", minval=1)

rangeLookback = input.int(20, "Range Lookback", minval=5)
noPrintRangePips = input.float(30.0, "No Print Range Size ($)", step=0.5)
breakBufferPips = input.float(2.5, "Breakout Buffer ($)", step=0.1)

minSepATR = input.float(0.08, "Min Line Separation ATR", step=0.01)
minSlopeATR = input.float(0.045, "Min Main Slope ATR", step=0.005)
minCandleATR = input.float(0.30, "Min Candle Range ATR", step=0.01)
lineBlockATR = input.float(0.35, "Too Close To Line Block ATR", step=0.01)

cooldownBars = input.int(10, "Cooldown Bars After Print", minval=1)

htfTf = input.timeframe("60", "Strong Context HTF")
htfLen = input.int(50, "1H Trend Strength Length", minval=5)
htfSlopeLookback = input.int(2, "1H Slope Lookback", minval=1)
htfSlopeATR = input.float(0.035, "1H Strong Trend Slope ATR", step=0.005)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// BACKTEST INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grpBt = "Backtest"
sizingMode = input.string("Risk %", "Position Sizing", options=["Risk %", "Fixed Lot"], group=grpBt)
riskPct = input.float(1.0, "Risk Per Trade (% of equity)", minval=0.05, maxval=10, step=0.05, group=grpBt)
lotSize = input.float(1.0, "Fixed Lot Size", minval=0.01, step=0.01, group=grpBt)
maxLot = input.float(5.0, "Max Lot Cap", minval=0.01, step=0.01, group=grpBt)
contractSize = input.float(100.0, "Contract Size (oz per 1 lot)", minval=1, group=grpBt)
slMode = input.string("Fixed $", "Stop Loss Mode", options=["Fixed $", "ATR"], group=grpBt)
slMove = input.float(10.0, "Stop Loss ($ move)", minval=0.1, step=0.1, group=grpBt)
slAtrMult = input.float(1.5, "Stop Loss ATR Mult", minval=0.1, step=0.1, group=grpBt)
tpMode = input.string("Fixed $", "Take Profit Mode", options=["Fixed $", "R:R"], group=grpBt)
tpMove = input.float(10.0, "Take Profit ($ move)", minval=0.1, step=0.1, group=grpBt)
rrRatio = input.float(1.5, "Take Profit R:R", minval=0.1, step=0.1, group=grpBt)
useTrail = input.bool(true, "Use Trailing SL", group=grpBt)
trailStart = input.float(5.0, "Trail Starts After Profit ($ move)", minval=0, step=0.1, group=grpBt)
trailOffset = input.float(3.0, "Trail Distance ($ move)", minval=0.01, step=0.1, group=grpBt)
keepTP = input.bool(true, "Keep Fixed TP With Trailing", group=grpBt)
exitOnOpposite = input.bool(true, "Close & Reverse On Opposite Signal", group=grpBt)
maxBarsInTrade = input.int(0, "Max Bars In Trade (0 = off)", minval=0, group=grpBt)
signalFilter = input.string("All", "Signals To Trade", options=["All", "Clean Only", "Strong Only"], group=grpBt)
tradeDir = input.string("Both", "Direction", options=["Both", "Long Only", "Short Only"], group=grpBt)
lockTf = input.bool(true, "Only Trade On 1/5/15/20/25/30M", group=grpBt)

grpDate = "Date Range"
useDate = input.bool(false, "Limit Date Range", group=grpDate)
startTime = input.time(timestamp("2025-01-01T00:00:00"), "Start", group=grpDate)
endTime = input.time(timestamp("2099-01-01T00:00:00"), "End", group=grpDate)
inDate = not useDate or (time >= startTime and time <= endTime)

grpRisk = "Risk Management"
useBE = input.bool(true, "Move SL To Breakeven", group=grpRisk)
beTrigger = input.float(4.0, "Breakeven After Profit ($ move)", minval=0.1, step=0.1, group=grpRisk)
beLock = input.float(0.5, "Breakeven Lock-In ($ above entry)", minval=0, step=0.1, group=grpRisk)
maxDailyLossPct = input.float(3.0, "Max Daily Loss % (0 = off)", minval=0, step=0.5, group=grpRisk)
maxDailyTrades = input.int(10, "Max Trades Per Day (0 = off)", minval=0, group=grpRisk)
maxLossStreak = input.int(3, "Stop For Day After X Losses In A Row (0 = off)", minval=0, group=grpRisk)
maxDDPct = input.float(20.0, "Stop Strategy At Max Drawdown % (0 = off)", minval=0, step=1, group=grpRisk)
useSession = input.bool(false, "Trade Only In Session", group=grpRisk)
sessionStr = input.session("0700-2000", "Session (chart timezone)", group=grpRisk)
closeEndOfDay = input.bool(false, "Close Open Trade At Session End", group=grpRisk)
showRiskPanel = input.bool(true, "Show Risk Panel", group=grpRisk)

strategy.risk.max_drawdown(maxDDPct > 0 ? maxDDPct : 100, strategy.percent_of_equity)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TIMEFRAME LOCK
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
isAllowedTf = not lockTf or timeframe.period == "1" or timeframe.period == "5" or timeframe.period == "15" or timeframe.period == "20" or timeframe.period == "25" or timeframe.period == "30"

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ZLEMA ENGINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
lagMain = int(math.floor((mainLen - 1) / 2))
mainAdj = lagMain > 0 ? close + (close - close[lagMain]) : close
mainLine = ta.ema(mainAdj, mainLen)

lagFast = int(math.floor((fastLen - 1) / 2))
fastAdj = lagFast > 0 ? close + (close - close[lagFast]) : close
fastLine = ta.ema(fastAdj, fastLen)

atr = ta.atr(atrLen)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RANGE / CHOP FILTER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
rangeHigh = ta.highest(high, rangeLookback)[1]
rangeLow = ta.lowest(low, rangeLookback)[1]
rangeSize = rangeHigh - rangeLow

insideCompression = rangeSize <= noPrintRangePips and close <= rangeHigh and close >= rangeLow
rangeBreakBuy = close > rangeHigh + breakBufferPips
rangeBreakSell = close < rangeLow - breakBufferPips
tooCloseToLine = math.abs(close - mainLine) < atr * lineBlockATR
allowPrintZone = not insideCompression and not tooCloseToLine

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// TREND + PRESSURE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
mainSlope = mainLine - mainLine[1]
sep = math.abs(fastLine - mainLine)

bullLine = fastLine > mainLine and close > mainLine
bearLine = fastLine < mainLine and close < mainLine
bullSlope = mainSlope > atr * minSlopeATR
bearSlope = mainSlope < -atr * minSlopeATR
sepOk = sep > atr * minSepATR
candleForce = (high - low) > atr * minCandleATR
bullPressure = close > high[1] and close > open
bearPressure = close < low[1] and close < open

rawBuy = allowPrintZone and rangeBreakBuy and bullLine and bullSlope and sepOk and candleForce and bullPressure
rawSell = allowPrintZone and rangeBreakSell and bearLine and bearSlope and sepOk and candleForce and bearPressure

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1 PRINT PER TREND + COOLDOWN
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var int trendLock = 0
var int lastSignalBar = na

canPrint = na(lastSignalBar) or (bar_index - lastSignalBar >= cooldownBars)

gkBuy = barstate.isconfirmed and rawBuy and trendLock != 1 and canPrint
gkSell = barstate.isconfirmed and rawSell and trendLock != -1 and canPrint

trendLock := gkBuy ? 1 : gkSell ? -1 : trendLock
lastSignalBar := gkBuy or gkSell ? bar_index : lastSignalBar

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1H CONTEXT — NON-REPAINTING (closed 1H bar only)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
htfClose = request.security(syminfo.tickerid, htfTf, close[1], barmerge.gaps_off, barmerge.lookahead_on)
htfAtr = request.security(syminfo.tickerid, htfTf, ta.atr(atrLen)[1], barmerge.gaps_off, barmerge.lookahead_on)
htfLine = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfLen)[1], barmerge.gaps_off, barmerge.lookahead_on)
htfSlope = request.security(syminfo.tickerid, htfTf, (ta.ema(close, htfLen) - ta.ema(close, htfLen)[htfSlopeLookback])[1], barmerge.gaps_off, barmerge.lookahead_on)

strongBull1H = htfClose > htfLine and htfSlope > htfAtr * htfSlopeATR
strongBear1H = htfClose < htfLine and htfSlope < -htfAtr * htfSlopeATR

strongBuy = gkBuy and strongBear1H
strongSell = gkSell and strongBull1H
cleanBuy = gkBuy and not strongBuy
cleanSell = gkSell and not strongSell

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ENTRY FILTERS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
buyPass = signalFilter == "All" ? gkBuy : signalFilter == "Clean Only" ? cleanBuy : strongBuy
sellPass = signalFilter == "All" ? gkSell : signalFilter == "Clean Only" ? cleanSell : strongSell

allowLong = tradeDir != "Short Only"
allowShort = tradeDir != "Long Only"

goLong = isAllowedTf and inDate and allowLong and buyPass
goShort = isAllowedTf and inDate and allowShort and sellPass

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RISK MANAGEMENT — DAILY GUARDS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
newDay = ta.change(time("D")) != 0
totalTrades = strategy.closedtrades + strategy.opentrades

var float dayStartEquity = strategy.initial_capital
var int dayStartTrades = 0
var int lossStreak = 0
var int lastClosedCount = 0

if newDay
    dayStartEquity := strategy.equity
    dayStartTrades := totalTrades
    lossStreak := 0

if strategy.closedtrades > lastClosedCount
    for i = lastClosedCount to strategy.closedtrades - 1
        lossStreak := strategy.closedtrades.profit(i) < 0 ? lossStreak + 1 : 0
    lastClosedCount := strategy.closedtrades

dayPnL = strategy.equity - dayStartEquity
dayPnLPct = dayStartEquity > 0 ? dayPnL / dayStartEquity * 100 : 0.0
tradesToday = totalTrades - dayStartTrades

dailyLossHit = maxDailyLossPct > 0 and dayPnLPct <= -maxDailyLossPct
dailyTradesHit = maxDailyTrades > 0 and tradesToday >= maxDailyTrades
streakHit = maxLossStreak > 0 and lossStreak >= maxLossStreak

inSession = not useSession or not na(time(timeframe.period, sessionStr))
riskOk = not dailyLossHit and not dailyTradesHit and not streakHit and inSession

if dailyLossHit and strategy.position_size != 0
    strategy.close_all(comment="Daily Loss")

if useSession and closeEndOfDay and not inSession and strategy.position_size != 0
    strategy.close_all(comment="Session End")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// POSITION SIZE (risk % of equity / SL distance)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
slDist = slMode == "Fixed $" ? slMove : atr * slAtrMult
tpDist = tpMode == "R:R" ? slDist * rrRatio : tpMove

riskLots = (strategy.equity * riskPct / 100) / (slDist * contractSize)
calcLots = sizingMode == "Risk %" ? math.floor(riskLots * 100) / 100 : lotSize
tradeLots = math.min(calcLots, maxLot)
orderQty = tradeLots * contractSize
sizeOk = tradeLots >= 0.01

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ORDERS
// Signal on bar close -> fill on next bar open.
// TP/SL are measured from the signal candle close (same as the indicator's TP).
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var float longTP = na
var float longSL = na
var float shortTP = na
var float shortSL = na

canLong = strategy.position_size == 0 or (strategy.position_size < 0 and exitOnOpposite)
canShort = strategy.position_size == 0 or (strategy.position_size > 0 and exitOnOpposite)

if goLong and canLong and riskOk and sizeOk
    longTP := close + tpDist
    longSL := close - slDist
    strategy.entry("GK BUY", strategy.long, qty=orderQty, comment=strongBuy ? "BUY Strong" : "BUY")

if goShort and canShort and riskOk and sizeOk
    shortTP := close - tpDist
    shortSL := close + slDist
    strategy.entry("GK SELL", strategy.short, qty=orderQty, comment=strongSell ? "SELL Strong" : "SELL")

// breakeven: once price moves beTrigger in profit, pull SL to entry + beLock (never loosens)
if useBE and strategy.position_size > 0 and high - strategy.position_avg_price >= beTrigger
    longSL := math.max(longSL, strategy.position_avg_price + beLock)
if useBE and strategy.position_size < 0 and strategy.position_avg_price - low >= beTrigger
    shortSL := math.min(shortSL, strategy.position_avg_price - beLock)

// trailing SL: arms once price moves trailStart in profit, then follows price at trailOffset
trailPts = useTrail ? math.max(trailStart, syminfo.mintick) / syminfo.mintick : na
trailOff = useTrail ? trailOffset / syminfo.mintick : na
exitLongTP = useTrail and not keepTP ? na : longTP
exitShortTP = useTrail and not keepTP ? na : shortTP

strategy.exit("XL", from_entry="GK BUY", limit=exitLongTP, stop=longSL, trail_points=trailPts, trail_offset=trailOff, comment_profit="TP", comment_loss="SL", comment_trailing="Trail")
strategy.exit("XS", from_entry="GK SELL", limit=exitShortTP, stop=shortSL, trail_points=trailPts, trail_offset=trailOff, comment_profit="TP", comment_loss="SL", comment_trailing="Trail")

// time exit
if maxBarsInTrade > 0 and strategy.position_size != 0
    entryBarIdx = strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    if bar_index - entryBarIdx >= maxBarsInTrade
        strategy.close_all(comment="Time")

if useDate and time > endTime
    strategy.close_all(comment="End")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// VISUALS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
lineColor = bullLine ? color.lime : bearLine ? color.red : color.orange
plot(isAllowedTf ? mainLine : na, title="GK Main Line", color=lineColor, linewidth=3)

plot(strategy.position_size > 0 ? exitLongTP : na, "Long TP", color.green, 1, plot.style_linebr)
plot(strategy.position_size > 0 ? longSL : na, "Long SL", color.red, 1, plot.style_linebr)
plot(strategy.position_size < 0 ? exitShortTP : na, "Short TP", color.green, 1, plot.style_linebr)
plot(strategy.position_size < 0 ? shortSL : na, "Short SL", color.red, 1, plot.style_linebr)

barcolor(isAllowedTf and (gkBuy or gkSell) ? color.rgb(0, 255, 255) : na)

plotshape(isAllowedTf and cleanBuy, title="GK BUY", text="GK BUY", style=shape.labelup, location=location.belowbar, color=color.green, textcolor=color.white, size=size.small)
plotshape(isAllowedTf and cleanSell, title="GK SELL", text="GK SELL", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)
plotshape(isAllowedTf and strongBuy, title="GK BUY STRONG", text="BUY\nStrong", style=shape.labelup, location=location.belowbar, color=color.orange, textcolor=color.white, size=size.small)
plotshape(isAllowedTf and strongSell, title="GK SELL STRONG", text="SELL\nStrong", style=shape.labeldown, location=location.abovebar, color=color.orange, textcolor=color.white, size=size.small)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// RISK PANEL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var table riskTable = table.new(position.top_right, 2, 6, border_width=1)
if showRiskPanel and barstate.islast
    status = dailyLossHit ? "STOP: Daily Loss" : streakHit ? "STOP: Loss Streak" : dailyTradesHit ? "STOP: Max Trades" : not inSession ? "Out Of Session" : "ACTIVE"
    statusColor = status == "ACTIVE" ? color.new(color.green, 20) : color.new(color.red, 20)
    table.cell(riskTable, 0, 0, "RISK", text_color=color.white, bgcolor=color.black)
    table.cell(riskTable, 1, 0, status, text_color=color.white, bgcolor=statusColor)
    table.cell(riskTable, 0, 1, "Equity", text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(riskTable, 1, 1, "$" + str.tostring(strategy.equity, "#,###.00"), text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(riskTable, 0, 2, "Today P&L", text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(riskTable, 1, 2, str.tostring(dayPnL, "#,###.00") + " (" + str.tostring(dayPnLPct, "#.##") + "%)", text_color=color.white, bgcolor=dayPnL >= 0 ? color.new(color.green, 40) : color.new(color.red, 40))
    table.cell(riskTable, 0, 3, "Trades Today", text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(riskTable, 1, 3, str.tostring(tradesToday) + (maxDailyTrades > 0 ? " / " + str.tostring(maxDailyTrades) : ""), text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(riskTable, 0, 4, "Loss Streak", text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(riskTable, 1, 4, str.tostring(lossStreak), text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(riskTable, 0, 5, "Next Lot", text_color=color.white, bgcolor=color.new(color.blue, 30))
    table.cell(riskTable, 1, 5, str.tostring(tradeLots, "#.##") + " (risk $" + str.tostring(tradeLots * contractSize * slDist, "#,###") + ")", text_color=color.white, bgcolor=color.new(color.blue, 30))
