# --- Deriv API credentials ---
# 1. Sign up free at https://deriv.com — a demo account with virtual USD
#    balance is created automatically, no KYC needed until you fund a real
#    account.
# 2. Create an API token: log in -> Settings -> API token -> create one
#    with "Read", "Trade", and "Trading information" scopes.
# 3. DERIV_APP_ID can be left as the default below (Deriv's public demo
#    app_id) unless you've registered your own app at api.deriv.com.
DERIV_APP_ID=1089
DERIV_API_TOKEN=

# IMPORTANT: trading real (non-INR) forex/gold from India through an
# overseas broker like Deriv carries real legal risk under RBI/FEMA rules —
# this is not just a broker choice, it's a personal legal risk you accept
# by using this. See the chat history where this was explained and chosen.

INSTRUMENTS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD,frxUSDCAD,frxUSDCHF,frxNZDUSD,frxEURGBP,frxEURJPY,frxGBPJPY,frxXAUUSD

# The master live/paper switch — identical role to the other two teams'.
# Must be exactly "true" for real contracts to be bought on Deriv; anything
# else runs the full team pipeline and logs what it *would* have done
# instead (paper trading). Default false on purpose.
LIVE_TRADING_ENABLED=false

ACCOUNT_CURRENCY=USD
# Deriv's free demo accounts start with roughly 10,000 virtual USD balance
# by default.
PAPER_STARTING_BALANCE=10000

# --- Risk policy (same philosophy as the other two teams: small per-trade
#     risk, low leverage-equivalent, fixed 1:3 risk:reward, tight daily
#     loss cap) ---
PER_TRADE_RISK_PCT=1
# Deriv Multiplier contracts only accept specific values per instrument
# (commonly 5/10/20/30/50/100 for forex) — check your account if this
# value gets rejected once live.
MULTIPLIER=10
STOP_LOSS_PCT=0.3
TAKE_PROFIT_PCT=0.9
MIN_BULL_CONFIDENCE=40
MAX_CONCURRENT_TRADES=0
MAX_TOTAL_EXPOSURE_PCT=25
DAILY_LOSS_CAP_PCT=3
TRADE_COOLDOWN_MIN=15

# --- Candles / signal timing ---
CANDLE_GRANULARITY_SEC=300
CANDLE_COUNT=250
POLL_INTERVAL_MS=15000

# --- Telegram trade alerts (same bot/chat as the other two teams, or a
#     separate one) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
