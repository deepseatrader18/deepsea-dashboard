# --- OANDA API credentials ---
# 1. Sign up for a free OANDA practice (demo) account at oanda.com — no
#    real money needed, this is exactly what you want to start with.
# 2. Generate a Personal Access Token: My Account -> Manage API Access.
# 3. Your Account ID is shown on your OANDA dashboard (format like
#    101-004-XXXXXXX-001).
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# 'practice' = OANDA's free demo environment (fake money, real live prices)
# — safe default, used both for reading prices and, once
# LIVE_TRADING_ENABLED below is also true, for where any real order lands.
# Only switch to 'live' once you've funded a real OANDA account.
OANDA_ENVIRONMENT=practice

# Every pair this team scans and can trade — comma-separated. Defaults to
# the major FX pairs (most liquid, tightest spreads) plus gold. Add/remove
# pairs here without touching code. Full OANDA instrument list:
# https://developer.oanda.com
INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,USD_CHF,NZD_USD,EUR_GBP,EUR_JPY,GBP_JPY,XAU_USD

# The master live/paper switch — identical role to crypto-agents' one.
# Must be exactly "true" for real orders to be placed on OANDA; anything
# else runs the full team pipeline and logs what it *would* have done
# instead (paper trading). Default false on purpose.
LIVE_TRADING_ENABLED=false

# Simulated starting capital for paper trading. Defaulted to 100,000
# because OANDA's own free practice accounts are funded with roughly this
# much virtual money by default, and forex/gold position sizes need a
# realistically-sized balance to size even one conservative-leverage unit.
PAPER_STARTING_BALANCE=100000

# --- Risk policy (same philosophy as crypto-agents: small per-trade risk,
#     low leverage, fixed 1:3 risk:reward, tight daily loss cap) ---
PER_TRADE_RISK_PCT=1
# Kept low on purpose — low leverage means the account's own stop-loss
# always fires long before any margin-call risk becomes real.
FOREX_LEVERAGE=5
# Risk:reward fixed at 1:3 — target is exactly 3x the stop distance.
STOP_LOSS_PCT=0.3
TAKE_PROFIT_PCT=0.9
MIN_BULL_CONFIDENCE=40
# 0 = no cap on concurrent trades across pairs — MAX_TOTAL_EXPOSURE_PCT
# below is the real safety net for that.
MAX_CONCURRENT_TRADES=0
MAX_TOTAL_EXPOSURE_PCT=25
DAILY_LOSS_CAP_PCT=3
TRADE_COOLDOWN_MIN=15

# --- Candles / signal timing ---
CANDLE_GRANULARITY=M5
CANDLE_COUNT=250
# How often to poll OANDA for a new candle / open-position status, per
# pair — a periodic poll is the right speed here, not a live stream.
POLL_INTERVAL_MS=15000

# --- Telegram trade alerts (same bot/chat as crypto-agents, or a separate
#     one — either works, this just needs its own copy of the values since
#     this runs as an independent process) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
