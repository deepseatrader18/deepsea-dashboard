# --- Binance API keys (create at binance.com -> Account -> API Management) ---
# IMPORTANT: create keys with "Enable Futures" checked (this bot trades
# Binance USDT-M Futures, not Spot, so it can go both long and short), but
# do NOT enable withdrawals on this key. Also restrict the key to this
# VPS's IP address under Binance's API key IP-access-restriction setting —
# without that, anyone who steals this .env file can trade (and IP
# restriction is your only defense besides that). You'll also need to
# transfer some USDT into your Futures wallet (separate from Spot) before
# going live — paper mode doesn't need any of this yet.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# The master live/paper switch. Must be exactly "true" (lowercase) for
# real orders to be placed — anything else (unset, "false", a typo) runs
# the whole team pipeline and logs what it *would* have done instead
# (paper trading). Default is false on purpose — test with paper trading
# first, check the results (win rate, P/L) on the /crypto dashboard page
# or in this process's logs, and only flip this once you're happy.
# This is also the fastest kill-switch: set back to false and restart to
# stop all new trading instantly (an already-open position's stop/target
# orders sit on Binance's own servers and keep working even if this is
# off — but you should still manually close any open position if you're
# turning this off in an emergency, since a dangling order isn't the same
# as a flat position).
LIVE_TRADING_ENABLED=false

# Which coin the team trades against (Binance Futures quote asset). USDT-M
# futures only, so this should stay USDT unless Binance adds other quote
# assets to that market.
QUOTE_ASSET=USDT

# Leverage on every position — kept low on purpose. At 3x, the account's
# own stop-loss (STOP_LOSS_PCT below) will always fire long before
# Binance's liquidation price would ever be reached, so this is what
# actually keeps leverage from being the dangerous part of this bot.
# Do not raise this without understanding liquidation math first.
FUTURES_LEVERAGE=3

# Simulated starting capital for paper trading — set it to whatever amount
# you actually plan to trade with once live, so the paper results mean
# something for that real capital size.
PAPER_STARTING_BALANCE=1000

# --- Risk policy (conservative defaults — tune only once you understand
#     what each one does) ---
# % of free balance committed as MARGIN per trade (leverage then
# determines how much notional that margin controls).
PER_TRADE_RISK_PCT=1
# Risk:reward fixed at 1:3 — target is exactly 3x the stop distance, so
# even a sub-50% win rate can still be net profitable overall.
STOP_LOSS_PCT=0.5
TAKE_PROFIT_PCT=1.5
# After a surge is detected, wait this long (ms) and re-check price before
# actually entering — avoids buying/shorting the exact top/bottom of a
# spike, right before the pullback that would trip the stop-loss.
ENTRY_CONFIRM_DELAY_MS=8000
# If price is still running further away by more than this % during that
# wait, skip the trade rather than chase.
ENTRY_MAX_CHASE_PCT=0.15
# Minimum average confidence (0-100) the two researchers must show
# together before an entry is taken — fewer, higher-conviction trades.
MIN_BULL_CONFIDENCE=40
# 0 = no cap on concurrent trades — trade every coin that clears the
# team's bar. MAX_TOTAL_EXPOSURE_PCT below is the real safety net for that.
MAX_CONCURRENT_TRADES=0
# Hard ceiling on total margin committed across ALL open positions at
# once, as a % of the day's starting balance — this is what keeps the
# account safe when MAX_CONCURRENT_TRADES is uncapped.
MAX_TOTAL_EXPOSURE_PCT=25
DAILY_LOSS_CAP_PCT=3
SYMBOL_COOLDOWN_MIN=15
# If live price gaps past the stop-loss trigger by more than this %
# without the stop order actually filling (a fast/illiquid move can jump
# straight through), monitor.js force-closes the position with an
# emergency market order instead of leaving it exposed.
GAP_PROTECTION_BUFFER_PCT=1

# --- Speed: real-time scanning + fast bookkeeping ---
# Volume-surge scanning runs over a live Binance Spot WebSocket by default
# (broader coin coverage than Futures alone; only symbols that also have a
# Futures perpetual are actually traded). Updates ~every 1 second across
# the whole exchange instead of polling — this is what makes surge
# detection fast. Only set this to false if your VPS's network blocks
# outbound WebSocket connections and you need the slower REST fallback
# (SCAN_INTERVAL_MS then controls that poll interval).
WS_SCANNER_ENABLED=true
SCAN_INTERVAL_MS=20000
VOLUME_SURGE_MULTIPLIER=3
MIN_QUOTE_VOLUME_24H=2000000
MIN_DELTA_QUOTE_VOLUME=10000
# How often open positions are checked for their exit + status is reported
# (bookkeeping speed, not trading speed — the real take-profit/stop-loss
# already lives on Binance's own engine and fires instantly on its own,
# regardless of this number).
POSITION_TICK_MS=3000
# How often the live balance cache is corrected against the real Binance
# Futures wallet (fee/funding drift) — the trading decision itself never
# waits on this.
BALANCE_RESYNC_MS=120000

# --- Telegram trade alerts (sent directly from here — no WhatsApp) ---
# Every entry, every target-hit, every stopped-out gets its own Telegram
# message. Create a bot via @BotFather on Telegram to get a token, then
# message your bot once and check
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Reporting status/trades to the Render dashboard's Crypto Trading
#     Room page (optional, independent of Telegram — trading still works
#     without this, you just won't see live status on /crypto) ---
# Any random string — set the exact same value as CRYPTO_BRIDGE_TOKEN on
# the deepsea-dashboard Render service's environment variables.
CRYPTO_BRIDGE_TOKEN=
DASHBOARD_URL=https://deepsea-dashboard.onrender.com
